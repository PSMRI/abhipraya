<?xml version="1.0" encoding="UTF-8"?>
<!--
    The UI is static. Database configuration belongs only to the server-side API
    configuration and must never be stored beneath the public UI directory.
-->
<configuration>
  <!-- Development-friendly: changes to the modular UI assets are picked up
       immediately. Enable long-lived hashed-asset caching for production. -->
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
