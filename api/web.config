<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Configuration revision: 2026-07-21-csrf-path-fix -->
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Server" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <remove name="Cache-Control" />
        <remove name="Pragma" />
        <add name="Cache-Control" value="no-store, no-cache, must-revalidate, max-age=0" />
        <add name="Pragma" value="no-cache" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>
    <rewrite>
      <rules>
        <rule name="Abhipraya current login endpoint" stopProcessing="true">
          <match url="^v1/auth/login-current/?$" />
          <action type="Rewrite" url="modules/auth/v1/login-current.php" appendQueryString="false" />
        </rule>
        <rule name="Abhipraya current authenticated-user endpoint" stopProcessing="true">
          <match url="^v1/auth/me/?$" />
          <action type="Rewrite" url="modules/auth/v1/me-current.php" appendQueryString="false" />
        </rule>
        <rule name="Abhipraya CSRF token endpoint" stopProcessing="true">
          <match url="^v1/auth/csrf-token/?$" />
          <action type="Rewrite" url="modules/auth/v1/csrf-token.php" appendQueryString="false" />
        </rule>
        <rule name="Abhipraya current CSRF endpoint" stopProcessing="true">
          <match url="^v1/auth/csrf/?$" />
          <action type="Rewrite" url="modules/auth/v1/csrf-current.php" appendQueryString="false" />
        </rule>
        <rule name="Abhipraya public survey location check" stopProcessing="true">
          <match url="^v1/public-survey/location/?$" />
          <action type="Rewrite" url="modules/public-survey/v1/location.php" appendQueryString="true" />
        </rule>
        <rule name="Abhipraya CAPA actions" stopProcessing="true">
          <match url="^v1/capa/actions/?$" />
          <action type="Rewrite" url="modules/capa/v1/actions.php" appendQueryString="true" />
        </rule>
        <rule name="Abhipraya versioned API router" stopProcessing="true">
          <match url="^v[0-9]+/(.*)$" />
          <action type="Rewrite" url="index.php?path=/{R:0}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
