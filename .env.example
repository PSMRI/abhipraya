# Session storage: use Redis-compatible Memurai when PHP is configured with
# the redis session handler. Use files only for local/single-server setups.
ABHIPRAYA_SESSION_HANDLER=redis

# Event delivery defaults to local JSON-line logs. Enable Kafka only after
# php-rdkafka and a protected broker are configured.
ABHIPRAYA_EVENT_DRIVER=local
# ABHIPRAYA_KAFKA_BROKERS=<private-broker-host>:9092
# ABHIPRAYA_KAFKA_TOPIC_PREFIX=abhipraya
