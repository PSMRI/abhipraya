<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect legacy dashboard page" stopProcessing="true">
          <match url="^ui/pages/dashboard/index\.html$" />
          <action type="Redirect" url="/admin/dashboard" redirectType="Found" />
        </rule>
        <rule name="Redirect legacy QR page" stopProcessing="true">
          <match url="^ui/pages/qr/generate\.html$" />
          <action type="Redirect" url="/admin/qr" redirectType="Found" />
        </rule>
        <rule name="Redirect legacy account page" stopProcessing="true">
          <match url="^ui/pages/account/security\.html$" />
          <action type="Redirect" url="/admin/account" redirectType="Found" />
        </rule>
        <rule name="Redirect legacy login page" stopProcessing="true">
          <match url="^ui/pages/auth/login\.html$" />
          <action type="Redirect" url="/admin/login" redirectType="Found" />
        </rule>
        <rule name="Redirect legacy public survey page" stopProcessing="true">
          <match url="^ui/pages/public-survey/survey\.php$" />
          <action type="Redirect" url="/question.php" appendQueryString="true" redirectType="Found" />
        </rule>
        <rule name="Abhipraya admin login" stopProcessing="true">
          <match url="^admin/login/?$" />
          <action type="Rewrite" url="ui/router.php?route=admin/login" appendQueryString="true" />
        </rule>
        <rule name="Abhipraya dashboard" stopProcessing="true">
          <match url="^admin/dashboard/?$" />
          <action type="Rewrite" url="ui/router.php?route=admin/dashboard" appendQueryString="true" />
        </rule>
        <rule name="Abhipraya account" stopProcessing="true">
          <match url="^admin/account/?$" />
          <action type="Rewrite" url="ui/router.php?route=admin/account" appendQueryString="true" />
        </rule>
        <rule name="Abhipraya indicator reports" stopProcessing="true">
          <match url="^admin/reports/?$" />
          <action type="Rewrite" url="ui/router.php?route=admin/reports" appendQueryString="true" />
        </rule>
        <rule name="Abhipraya QR management" stopProcessing="true">
          <match url="^admin/qr/?$" />
          <action type="Rewrite" url="ui/router.php?route=admin/qr" appendQueryString="true" />
        </rule>
        <rule name="Abhipraya CAPA" stopProcessing="true">
          <match url="^admin/capa/?$" />
          <action type="Rewrite" url="ui/router.php?route=admin/capa" appendQueryString="true" />
        </rule>
        <rule name="Abhipraya public survey" stopProcessing="true">
          <match url="^survey/?$" />
          <action type="Rewrite" url="ui/router.php?route=question" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
